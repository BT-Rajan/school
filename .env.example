# Public name of this server. Phones must reach it over HTTPS from the internet.
SCES_DOMAIN=sces.example.org

# Generate: SECRET with `openssl rand -base64 48`; ENCRYPTION with
# `openssl rand -base64 32 | tr "+/" "-_" | tr -d "="` (32 bytes, base64url).
SCES_SECRET_KEY=
SCES_ENCRYPTION_KEY=

# Database passwords. Use long random values.
SCES_DB_ROOT_PASSWORD=
SCES_APP_DB_PASSWORD=

# Mail: gmail (default), smtp, or console (development only). See docs/deployment.md.
SCES_MAIL_PROVIDER=gmail
SCES_MAIL_SENDER=district.sces@gmail.com
SCES_MAIL_SENDER_NAME=School Cluster Evaluation System
SCES_GMAIL_CLIENT_ID=
SCES_GMAIL_CLIENT_SECRET=
SCES_GMAIL_REFRESH_TOKEN=

# Only for SCES_MAIL_PROVIDER=smtp
SCES_SMTP_HOST=
SCES_SMTP_PORT=587
SCES_SMTP_USERNAME=
SCES_SMTP_PASSWORD=

# Backups (deploy/backup.sh): where encrypted backups go, and the passphrase file.
SCES_BACKUP_DIR=/srv/sces-backups
SCES_BACKUP_PASSPHRASE_FILE=/root/.sces-backup-passphrase
