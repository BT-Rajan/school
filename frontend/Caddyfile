# SCES_DOMAIN is the public name of the server, for example sces.example.org.
# Caddy obtains and renews a publicly trusted certificate for it.
{$SCES_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Everything else, including the page and the service worker, is fetched fresh so updates reach users.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# "?" sets a default only: API responses, such as file previews, keep their own stricter rules.
		?X-Frame-Options DENY
		?Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
